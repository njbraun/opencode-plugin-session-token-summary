{
  "name": "opencode-plugin-session-token-summary",
  "version": "2.1.5",
  "description": "OpenCode TUI sidebar showing token usage across a session and its subagents.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/njbraun/opencode-plugin-session-token-summary.git"
  },
  "homepage": "https://github.com/njbraun/opencode-plugin-session-token-summary#readme",
  "bugs": {
    "url": "https://github.com/njbraun/opencode-plugin-session-token-summary/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "tokens",
    "usage",
    "subagents"
  ],
  "type": "module",
  "exports": {
    "./tui": {
      "default": "./dist/tui.js"
    }
  },
  "oc-plugin": [
    "tui"
  ],
  "files": [
    "dist/tui.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "release": "bun scripts/release.ts",
    "build": "bun -e 'import solid from \"@opentui/solid/bun-plugin\"; const r = await Bun.build({ entrypoints: [\"./tui.tsx\"], outdir: \"./dist\", target: \"bun\", packages: \"external\", plugins: [solid] }); if (!r.success) { for (const l of r.logs) console.error(l); process.exit(1); }'",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "bun test --preload @opentui/solid/preload",
    "check": "npm run typecheck && npm run test",
    "pack:check": "npm pack --dry-run",
    "preversion": "npm run check && npm run pack:check",
    "prepublishOnly": "npm run check && npm run pack:check"
  },
  "engines": {
    "opencode": ">=2.0.28 <3"
  },
  "dependencies": {
    "@opencode/client": "^2.0.28",
    "@opencode/plugin": "^2.0.28"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.6.6",
    "@opentui/solid": ">=0.6.6",
    "solid-js": "^1.9.12"
  },
  "devDependencies": {
    "@opentui/core": "^0.8.3",
    "@opentui/solid": "^0.8.3",
    "solid-js": "^1.9.12",
    "@types/bun": "^1.3.14",
    "typescript": "^5.8.2"
  }
}
